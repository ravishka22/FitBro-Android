<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark Mode) -->
    <style name="Theme.FitBro" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/electric_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/electric_green_variant</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/electric_green</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/md_theme_dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Backgrounds & Surfaces -->
        <item name="android:windowBackground">@color/md_theme_dark_background</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>
        
        <!-- Custom attributes -->
        <item name="logoSrc">@drawable/logo_dark</item>

        <!-- Apply Pill Styles globally -->
        <item name="materialButtonStyle">@style/Widget.FitBro.Button</item>
        <item name="textInputStyle">@style/Widget.FitBro.TextInputLayout</item>
    </style>
</resources>