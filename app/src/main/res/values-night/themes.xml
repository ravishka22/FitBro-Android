<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark Mode) -->
    <style name="Theme.FitBro" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/electric_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/electric_green_variant</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/electric_green</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/deep_charcoal</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/deep_charcoal</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- Custom attributes -->
        <item name="logoSrc">@drawable/logo_dark</item>

        <!-- Apply Pill Styles globally -->
        <item name="materialButtonStyle">@style/Widget.FitBro.Button</item>
        <item name="textInputStyle">@style/Widget.FitBro.TextInputLayout</item>
    </style>

    <!-- Pill shaped Button Style -->
    <style name="Widget.FitBro.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Pill shaped TextInputLayout Style -->
    <style name="Widget.FitBro.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
    </style>
</resources>