<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.5" />

        <TextView
            android:id="@+id/tvUserNameDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="John Doe"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGoalDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Goal: Muscle Gain"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMedicalDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Medical: No known issues"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/tvDaysDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preferred: 4 days/week"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Physique Assessment"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llPhotoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <!-- Photos will be injected here or use a specific layout -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFrontDetail"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FitBro.RoundedSquare"
                android:background="?attr/colorOutlineVariant" />
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivSideDetail"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FitBro.RoundedSquare"
                android:background="?attr/colorOutlineVariant" />
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivBackDetail"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FitBro.RoundedSquare"
                android:background="?attr/colorOutlineVariant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreatePlanFromDetail"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="CREATE CUSTOM PLAN"
            android:textStyle="bold"
            app:cornerRadius="30dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>